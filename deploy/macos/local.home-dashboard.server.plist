<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Šablona — install.sh doplní __…__ a uloží do ~/Library/LaunchAgents/.
     HTTP server na 127.0.0.1 (scripts/local/server.py): /data/*.json, /refresh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.home-dashboard.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/scripts/local/server.py</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>__PORT__</string>
    <string>--log-file</string>
    <string>__LOGS__/server.log</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HD_HOME</key>
    <string>__HD_HOME__</string>
    <key>HD_ENV_FILE</key>
    <string>__ENV_FILE__</string>
    <!-- Runner spuštěný tlačítkem „obnovit" loguje zvlášť (rotace z více procesů) -->
    <key>HD_RUNNER_LOG</key>
    <string>__LOGS__/refresh.log</string>
    <key>PYTHONUTF8</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOGS__/server.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/server.launchd.log</string>
</dict>
</plist>
