# Konfigurace domácího serveru home_dashboard — náhrada GitHub Secrets.
#
# Umístění: ~/.config/home_dashboard/env   (install.sh ho vytvoří z tohoto vzoru)
# Práva:    chmod 600 — se širšími právy ho fetch skripty odmítnou načíst.
# Nikdy necommituj vyplněnou kopii.
#
# Formát: KEY=VALUE, jeden na řádek. Hodnota je vše za prvním „=" až do konce
# řádku (žádné komentáře za hodnotou — tokeny mohou obsahovat # i =).
# Volitelně v uvozovkách "…" nebo '…'. Prázdná hodnota = jako chybějící secret.
# Význam proměnných je stejný jako u GitHub Secrets (viz CLAUDE.md, tabulka secrets).

# ── Growatt (stačí API token, jméno/heslo je legacy záloha) ──────────────────
GROWATT_API_TOKEN=
GROWATT_USER=
GROWATT_PASS=

# ── Tuya IoT Cloud ───────────────────────────────────────────────────────────
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_DEVICE_ID_2=
TUYA_DEVICE_ID_3=
TUYA_REGION=eu

# ── Netatmo ──────────────────────────────────────────────────────────────────
# Rotující refresh token se ukládá do ~/Library/Application Support/
# home_dashboard/state/netatmo_token.enc; NETATMO_REFRESH_TOKEN je jen seed.
# Pozor: dokud běží i workflow netatmo.yml, NEPOUŽÍVEJ stejný token (ani
# zkopírovaný netatmo_token.enc) — dva odběratelé rotujícího tokenu si ho
# navzájem zneplatní. Viz HOMESERVER.md → „Souběžný provoz".
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
# Nový náhodný řetězec (např. `openssl rand -hex 32`), ne ten z GitHub Secrets
NETATMO_TOKEN_KEY=

# ── Kalendář (iCal URL — sama o sobě je tajná) ───────────────────────────────
CALENDAR_ICS_URL=

# ── Microsoft To Do (stejná pravidla pro rotující token jako Netatmo) ────────
MSTODO_CLIENT_ID=
MSTODO_REFRESH_TOKEN=
MSTODO_TOKEN_KEY=
MSTODO_TENANT=consumers
MSTODO_LIST=Vranov
